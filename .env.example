# ==============================================================================
# Environment Configuration Template
# Rename this file to .env for local environment overrides
# ==============================================================================

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Frontend Settings
# For local execution: http://127.0.0.1:8000
# For Docker Compose:  http://backend:8000
API_URL=http://127.0.0.1:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Model & Artifact Locations
MODELS_DIR=models
MODEL_PATH=models/best_churn_model.joblib
AUDIT_REPORT_PATH=models/model_comparison_report.json
